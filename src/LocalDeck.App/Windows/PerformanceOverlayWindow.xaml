<Window x:Class="LocalDeck.App.Windows.PerformanceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalDeck Performance"
        Width="310"
        Height="340"
        MinWidth="220"
        MinHeight="180"
        MaxWidth="800"
        MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        SizeChanged="OnWindowSizeChanged">
    <Border x:Name="OverlaySurface"
            CornerRadius="16"
            Background="#F00B1118"
            BorderBrush="#3A5366"
            BorderThickness="1"
            Padding="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="5"
                              Opacity=".42"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragHeader"
                  MouseLeftButtonDown="OnHeaderMouseDown"
                  Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#61E7B8" Margin="0,0,8,0" />
                    <TextBlock Text="PERFORMANCE"
                               Foreground="#EAF3FA"
                               FontSize="11"
                               FontWeight="Bold" />
                </StackPanel>
                <Button x:Name="PreciseFpsButton"
                        Grid.Column="1"
                        Content="精确 FPS"
                        Foreground="#6BB8FF"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="9"
                        Padding="6,2"
                        Cursor="Hand"
                        Click="OnPreciseFpsClicked" />
                <Button Grid.Column="2"
                        Content="×"
                        Foreground="#8493A6"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        Padding="5,0"
                        Cursor="Hand"
                        Click="OnCloseClicked" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Margin="0,0,-5,0">
                <WrapPanel x:Name="MetricWrap"
                           HorizontalAlignment="Stretch" />
            </ScrollViewer>

            <Border x:Name="BatteryPanel"
                    Grid.Row="2"
                    Background="#8017212A"
                    CornerRadius="9"
                    Padding="10,8"
                    Margin="1,6,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="设备电量"
                               Foreground="#8493A6"
                               FontSize="9"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="BatteryList"
                               Grid.Row="1"
                               Foreground="#D7E2EC"
                               FontSize="10"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="正在读取已连接蓝牙设备…" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="1,9,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GpuSource"
                           Text="LOCAL ONLY"
                           Foreground="#566476"
                           FontSize="8" />
                <TextBlock x:Name="UpdatedAt"
                           Grid.Column="1"
                           Text=""
                           Foreground="#566476"
                           FontSize="8"
                           HorizontalAlignment="Right" />
                <Border x:Name="ResizeGrip"
                        Grid.Column="2"
                        Width="14"
                        Height="14"
                        Margin="3,-4,-4,-4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        MouseLeftButtonDown="OnResizeGripMouseDown"
                        ToolTip="拖动调整悬浮窗大小">
                    <Path Data="M 3,12 L 12,3 M 7,12 L 12,7 M 11,12 L 12,11"
                          Stroke="#718196"
                          StrokeThickness="1" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
